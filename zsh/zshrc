# ~/.zshrc — interactive only
[[ $- != *i* ]] && return

# Initialize modern completion engine
autoload -Uz compinit && compinit

if [[ "$(uname)" == "Darwin" ]]; then
  if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -f "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

source <(fzf --zsh)

setopt AUTO_CD                # type a folder name to 'cd' into it
setopt CORRECT                # spellchecking/auto-correct for typo'd commands

# keybindings for standard behaviors (Home, End, Delete) across different terminals
bindkey -e
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^H' backward-kill-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word

# Make Ctrl+backspace erase words (stops at slashes/symbols, not just spaces)
autoload -U select-word-style
select-word-style bash

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt EXTENDED_HISTORY       # Records timestamps; critical for advanced history management
setopt HIST_IGNORE_ALL_DUPS   # Erase old duplicate lines when writing new ones
setopt HIST_REDUCE_BLANKS     # Trim unnecessary spaces from commands
setopt SHARE_HISTORY          # Share history instantly across all running sessions
setopt HIST_IGNORE_SPACE      # Preceding a command with a space skips saving it to history
setopt PROMPT_SUBST

# Track SSH state ONCE at startup
if [[ -n $SSH_CLIENT ]] || [[ -n $SSH_TTY ]] || [[ -n $SSH_CONNECTION ]]; then
  _SSH_PROMPT_NOTE="%F{red}[SSH] %f"
else
  _SSH_PROMPT_NOTE=""
fi

# RUNS ONLY ON DIRECTORY CHANGE (Heavy)
__update_prompt_dir() {
  if [[ "$PWD" == "$HOME" ]]; then
    _CURRENT_DIR_PROMPT=""
  else
    _CURRENT_DIR_PROMPT="%F{blue}%1~ %f"
  fi

  typeset -f autoload_nvmrc >/dev/null && autoload_nvmrc
  typeset -f autoload_venv >/dev/null && autoload_venv
}

# RUNS BEFORE EVERY SINGLE PROMPT RENDERING (Lightweight)
__set_zsh_prompt() {
  local exit_status=$? # return code of the last app execution
  local fail=""
  local venv=""

  (( exit_status != 0 )) && fail="%F{red}✗ %f"

  # Dynamic check for virtualenv 
  if [[ -n $VIRTUAL_ENV ]]; then
    venv="%F{242}(${VIRTUAL_ENV:t}) %f"
  fi

  # Build target
  PROMPT="${fail}${_SSH_PROMPT_NOTE}${venv}${_CURRENT_DIR_PROMPT}%(!.%F{red}.%F{green})>%f "
  RPROMPT="%F{242}%D{%d %b %H:%M}%f"
}

__set_cursor() { printf '\e[6 q'; }

chpwd_functions+=( __update_prompt_dir )
precmd_functions+=( __set_zsh_prompt __set_cursor )

# Initialize for the very first shell screen paint
__update_prompt_dir

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
if [[ -n "$LS_COLORS" ]]; then
  zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
else
  zstyle ':completion:*' list-colors ''
fi

[[ -f ~/.zsh_funcs ]] && source ~/.zsh_funcs
[[ -f ~/.zsh_aliases ]] && source ~/.zsh_aliases
[[ -f ~/.zsh_exports ]] && source ~/.zsh_exports

# Zsh Autosuggestions
plugin_paths=(
  "/usr/share/zsh/plugins/zsh-autosuggestions"
  "/usr/share/zsh/plugins"
  "/usr/share/zsh-autosuggestions"
  "/opt/homebrew/share/zsh-autosuggestions"
  "/usr/local/share/zsh-autosuggestions"
)

for pdir in "${plugin_paths[@]}"; do
  if [[ -f "$pdir/zsh-autosuggestions.zsh" ]]; then
    source "$pdir/zsh-autosuggestions.zsh"
    break
  fi
done

ZSH_AUTOSUGGEST_STRATEGY=(history completion)

